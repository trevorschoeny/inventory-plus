{
  "schemaVersion": 1,
  "id": "inventoryplus",
  "version": "${version}",
  "icon": "assets/inventoryplus/icon.png",
  "name": "Inventory Plus",
  "description": "Client-side inventory quality-of-life: auto-restock, auto tool switch, sorting, move matching, locked slots, column cycler. Installs on any server.",
  "authors": [
    "trevorschoeny"
  ],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "inventoryplus.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.trevorschoeny.inventoryplus.InventoryPlus"
    ],
    "client": [
      "com.trevorschoeny.inventoryplus.InventoryPlusClient"
    ],
    "modmenu": [
      "com.trevorschoeny.inventoryplus.config.IPConfigModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.4.0 <8.0.0",
    "slotkit": ">=2.1.0 <3.0.0",
    "keybindery": ">=1.1.0"
  },
  "breaks": {
    "inventorymax": "*"
  }
}
